import { Theme } from "theme.slint";

// A slider that never overwrites its own `value`, so Rust stays the single source of truth.
export component ValueSlider inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1.0;
    callback changed(float);

    min-height: Theme.touch-target;

    property <length> track-start: Theme.slider-thumb / 2;
    property <length> track-length: max(0px, root.width - Theme.slider-thumb);
    property <float> fraction: root.maximum > 0 ? max(0.0, min(1.0, root.value / root.maximum)) : 0.0;

    Rectangle {
        x: root.track-start;
        y: (parent.height - self.height) / 2;
        width: root.track-length;
        height: Theme.slider-track;
        border-radius: self.height / 2;
        background: Theme.surface-raised;
    }
    Rectangle {
        x: root.track-start;
        y: (parent.height - self.height) / 2;
        width: root.track-length * root.fraction;
        height: Theme.slider-track;
        border-radius: self.height / 2;
        background: Theme.primary;
    }
    Rectangle {
        x: root.track-start + root.track-length * root.fraction - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.slider-thumb;
        height: Theme.slider-thumb;
        border-radius: self.width / 2;
        background: Theme.primary;
    }

    touch := TouchArea {
        function emit-value() {
            if (root.track-length > 0) {
                root.changed(max(0.0, min(1.0, (touch.mouse-x - root.track-start) / root.track-length)) * root.maximum);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.emit-value();
            }
        }
        moved => {
            self.emit-value();
        }
    }
}
