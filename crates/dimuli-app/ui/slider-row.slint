import { Theme } from "theme.slint";
import { ValueSlider } from "value-slider.slint";

// A labelled slider; shared by the editor panel and the settings screen.
export component SliderRow inherits HorizontalLayout {
    in property <string> label;
    in property <float> value;
    in property <float> maximum;
    callback changed(float);
    callback released();

    spacing: Theme.spacing-m;
    Text {
        width: Theme.label-width;
        text: root.label;
        font-size: Theme.font-m;
        color: Theme.on-surface;
        vertical-alignment: center;
    }
    ValueSlider {
        value: root.value;
        maximum: root.maximum;
        changed(v) => {
            root.changed(v);
        }
        released => {
            root.released();
        }
    }
}
