import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Backend } from "backend.slint";
import { Screen } from "types.slint";
import { StartScreen } from "start-screen.slint";
import { SettingsScreen } from "settings-screen.slint";
import { AboutScreen } from "about-screen.slint";
import { EditorScreen } from "editor-screen.slint";
import { MessageBanner } from "message-banner.slint";
import { BusyOverlay } from "busy-overlay.slint";
import { ConfirmDialog } from "confirm-dialog.slint";

export { Backend, Screen, Theme }

export component AppWindow inherits Window {
    title: "dimuli";
    background: Theme.background;
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;

    // The app is always dark; std widgets (AboutSlint) pick their text and logo colours from this.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Content is inset by the safe area (system bars, display cutout); Slint fills it, 0 on desktop.
    Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: max(0px, parent.width - root.safe-area-insets.left - root.safe-area-insets.right);
        height: max(0px, parent.height - root.safe-area-insets.top - root.safe-area-insets.bottom);

        if Backend.screen == Screen.start: StartScreen { }
        if Backend.screen == Screen.editor: EditorScreen { }
        if Backend.screen == Screen.settings: SettingsScreen { }
        if Backend.screen == Screen.about: AboutScreen { }

        MessageBanner {
            x: Theme.spacing-s;
            // Below the top bar so Zurück/Speichern/Teilen stay reachable while a message is shown.
            y: Theme.touch-target + 3 * Theme.spacing-s;
            width: parent.width - 2 * Theme.spacing-s;
        }
        BusyOverlay { }
        ConfirmDialog { }
    }
}
