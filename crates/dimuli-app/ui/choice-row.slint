import { Theme } from "theme.slint";
import { AppButton } from "app-button.slint";

// Buttons of which one is selected (format, export size, quality), in rows of `columns` equally wide buttons;
// the last row is padded with empty cells so all buttons keep the same width.
export component ChoiceRow inherits VerticalLayout {
    in property <[string]> labels;
    in property <int> selected: -1;
    in property <int> columns: 4;
    callback choose(int);

    spacing: Theme.spacing-s;
    for row in Math.ceil(root.labels.length / root.columns): HorizontalLayout {
        spacing: Theme.spacing-s;
        for column in root.columns: Rectangle {
            min-height: Theme.touch-target;
            if row * root.columns + column < root.labels.length: AppButton {
                width: parent.width;
                height: parent.height;
                compact: true;
                text: root.labels[row * root.columns + column];
                primary: row * root.columns + column == root.selected;
                clicked => {
                    root.choose(row * root.columns + column);
                }
            }
        }
    }
}
