import { Screen, MessageStyle, CellView, DividerView, TemplateView, LicenseEntry } from "types.slint";

// The only interface between the UI and Rust: properties flow in, callbacks flow out.
export global Backend {
    // --- state from Rust ---
    in property <Screen> screen: Screen.start;
    in property <bool> busy;
    in property <string> busy-text;
    in property <string> message-text;
    in property <MessageStyle> message-style: MessageStyle.notice;
    in property <bool> confirm-back-visible;
    in property <string> app-version;
    // SPDX identifier of the app's own license (from Cargo.toml).
    in property <string> app-license;
    in property <[LicenseEntry]> licenses;

    in property <[CellView]> cells;
    in property <[DividerView]> dividers;
    in property <[TemplateView]> templates;
    in property <int> active-template: -1;
    // Canvas size computed by Rust from the available area and the collage aspect.
    in property <length> canvas-width;
    in property <length> canvas-height;
    in property <color> collage-background: white;

    in property <int> aspect-index: -1;
    in property <float> spacing;
    in property <float> padding;
    in property <float> corner-radius;
    in property <float> max-spacing: 1.0;
    in property <float> max-padding: 1.0;
    in property <float> max-corner-radius: 1.0;
    in property <[color]> background-presets;
    in property <int> background-index: -1;

    // --- actions to Rust ---
    callback pick-images();
    callback settings-requested();
    callback about-requested();
    callback back-requested();
    callback back-confirmed();
    callback back-cancelled();
    callback save-requested();
    callback share-requested();
    callback dismiss-message();

    // The space available for the canvas (width, height).
    callback canvas-area-resized(length, length);
    callback canvas-pressed(length, length);
    callback canvas-moved(length, length);
    callback canvas-released(length, length);
    callback canvas-cancelled();
    callback canvas-long-pressed();
    // vertical scroll delta, pointer x, pointer y
    callback canvas-scrolled(length, length, length);
    callback canvas-pinch-started();
    // relative scale since the last call, center x, center y
    callback canvas-pinched(float, length, length);

    callback template-selected(int);
    callback aspect-selected(int);
    callback spacing-changed(float);
    callback padding-changed(float);
    callback corner-radius-changed(float);
    callback background-selected(int);

    // Current app defaults (indices into the preset lists; -1 = none).
    in property <int> default-aspect-index: -1;
    in property <float> default-spacing;
    in property <float> default-padding;
    in property <float> default-corner-radius;
    in property <int> default-background-index: -1;
    in property <color> default-background-color: white;
    // The colour picker dialog (modal); its colour is UI-only until applied.
    in property <bool> color-picker-visible;
    in property <color> color-picker-color: white;
    in property <int> export-size-index: -1;
    // 0..2: a preset; 3: custom value.
    in property <int> export-quality-index: -1;
    // Index of "Eigene" in the quality and background choices (from Rust).
    in property <int> custom-quality-index: -1;
    in property <int> custom-background-index: -1;
    in property <int> export-quality: 95;
    in property <int> min-export-quality: 50;
    in property <int> max-export-quality: 100;

    // App defaults (Part B adds the settings screen).
    callback default-aspect-selected(int);
    callback default-spacing-changed(float);
    callback default-padding-changed(float);
    callback default-corner-radius-changed(float);
    callback default-background-selected(int);
    callback export-size-selected(int);
    callback export-quality-selected(int);
    callback export-quality-custom-selected();
    // Exact quality from the custom slider (saved on release) and a +/- button step (saved at once).
    callback export-quality-changed(float);
    callback export-quality-stepped(int);
    // Sent when a default slider is released: the value is saved once, not on every drag step.
    callback settings-committed();
    callback color-picker-requested();
    callback color-picker-cancelled();
    callback color-picker-applied(color);
    callback settings-reset();
}
