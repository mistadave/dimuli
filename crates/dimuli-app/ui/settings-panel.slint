import { Theme } from "theme.slint";
import { Texts } from "texts.slint";
import { Backend } from "backend.slint";
import { SliderRow } from "slider-row.slint";
import { ChoiceRow } from "choice-row.slint";
import { SwatchRow } from "swatch-row.slint";

// Style panel of the editor (the current collage).
export component SettingsPanel inherits Rectangle {
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.spacing-m;
        spacing: Theme.spacing-s;

        Text {
            text: Texts.format;
            font-size: Theme.font-s;
            color: Theme.on-surface-muted;
        }
        ChoiceRow {
            labels: Texts.aspect-labels;
            selected: Backend.aspect-index;
            choose(index) => {
                Backend.aspect-selected(index);
            }
        }
        SliderRow {
            label: Texts.spacing;
            value: Backend.spacing;
            maximum: Backend.max-spacing;
            changed(v) => {
                Backend.spacing-changed(v);
            }
        }
        SliderRow {
            label: Texts.padding;
            value: Backend.padding;
            maximum: Backend.max-padding;
            changed(v) => {
                Backend.padding-changed(v);
            }
        }
        SliderRow {
            label: Texts.corner-radius;
            value: Backend.corner-radius;
            maximum: Backend.max-corner-radius;
            changed(v) => {
                Backend.corner-radius-changed(v);
            }
        }
        Text {
            text: Texts.background;
            font-size: Theme.font-s;
            color: Theme.on-surface-muted;
        }
        SwatchRow {
            colors: Backend.background-presets;
            selected: Backend.background-index;
            custom-index: Backend.custom-background-index;
            current: Backend.collage-background;
            choose(index) => {
                Backend.background-selected(index);
            }
            custom-requested => {
                Backend.color-picker-requested();
            }
        }
    }
}
