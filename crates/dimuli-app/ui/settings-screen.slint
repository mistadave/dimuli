import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Texts } from "texts.slint";
import { Backend } from "backend.slint";
import { AppButton } from "app-button.slint";
import { BackBar } from "back-bar.slint";
import { SliderRow } from "slider-row.slint";
import { ChoiceRow } from "choice-row.slint";
import { SwatchRow } from "swatch-row.slint";
import { Separator } from "separator.slint";
import { ValueSlider } from "value-slider.slint";

component Heading inherits Text {
    font-size: Theme.font-l;
    font-weight: 700;
    color: Theme.on-surface;
}

component Label inherits Text {
    font-size: Theme.font-s;
    color: Theme.on-surface-muted;
}

// App defaults: apply to new collages and to every export. Sliders save on release, buttons at once.
export component SettingsScreen inherits Rectangle {
    // Presentation-only state: the reset button asks once before it acts.
    property <bool> confirm-reset: false;

    VerticalLayout {
        BackBar {
            title: Texts.settings;
        }

        ScrollView {
            VerticalLayout {
                padding: Theme.spacing-m;
                spacing: Theme.spacing-s;

                Heading {
                    text: Texts.defaults-heading;
                }
                Label {
                    text: Texts.format;
                }
                ChoiceRow {
                    labels: Texts.aspect-labels;
                    selected: Backend.default-aspect-index;
                    choose(index) => {
                        Backend.default-aspect-selected(index);
                    }
                }
                Separator { }
                SliderRow {
                    label: Texts.spacing;
                    value: Backend.default-spacing;
                    maximum: Backend.max-spacing;
                    changed(v) => {
                        Backend.default-spacing-changed(v);
                    }
                    released => {
                        Backend.settings-committed();
                    }
                }
                SliderRow {
                    label: Texts.padding;
                    value: Backend.default-padding;
                    maximum: Backend.max-padding;
                    changed(v) => {
                        Backend.default-padding-changed(v);
                    }
                    released => {
                        Backend.settings-committed();
                    }
                }
                SliderRow {
                    label: Texts.corner-radius;
                    value: Backend.default-corner-radius;
                    maximum: Backend.max-corner-radius;
                    changed(v) => {
                        Backend.default-corner-radius-changed(v);
                    }
                    released => {
                        Backend.settings-committed();
                    }
                }
                Separator { }
                Label {
                    text: Texts.background;
                }
                SwatchRow {
                    colors: Backend.background-presets;
                    selected: Backend.default-background-index;
                    custom-index: Backend.custom-background-index;
                    current: Backend.default-background-color;
                    choose(index) => {
                        Backend.default-background-selected(index);
                    }
                    custom-requested => {
                        Backend.color-picker-requested();
                    }
                }

                Separator { }
                Heading {
                    text: Texts.export-heading;
                }
                Label {
                    text: Texts.export-size;
                }
                ChoiceRow {
                    labels: Texts.export-size-labels;
                    selected: Backend.export-size-index;
                    choose(index) => {
                        Backend.export-size-selected(index);
                    }
                }
                Separator { }
                Label {
                    text: Texts.export-quality;
                }
                ChoiceRow {
                    labels: Texts.export-quality-labels;
                    columns: 2;
                    selected: Backend.export-quality-index;
                    choose(index) => {
                        // "Eigene" only opens the slider; a preset sets the value.
                        if (index == Backend.custom-quality-index) {
                            Backend.export-quality-custom-selected();
                        } else {
                            Backend.export-quality-selected(index);
                        }
                    }
                }
                if Backend.export-quality-index == Backend.custom-quality-index: HorizontalLayout {
                    spacing: Theme.spacing-s;
                    AppButton {
                        max-width: Theme.touch-target;
                        text: "-";
                        clicked => {
                            Backend.export-quality-stepped(-1);
                        }
                    }
                    ValueSlider {
                        horizontal-stretch: 1;
                        value: Backend.export-quality - Backend.min-export-quality;
                        maximum: Backend.max-export-quality - Backend.min-export-quality;
                        changed(v) => {
                            Backend.export-quality-changed(v + Backend.min-export-quality);
                        }
                        released => {
                            Backend.settings-committed();
                        }
                    }
                    AppButton {
                        max-width: Theme.touch-target;
                        text: "+";
                        clicked => {
                            Backend.export-quality-stepped(1);
                        }
                    }
                    Text {
                        width: Theme.value-label-width;
                        text: Backend.export-quality;
                        font-size: Theme.font-m;
                        color: Theme.on-surface;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Separator { }
                if !root.confirm-reset: AppButton {
                    text: Texts.reset-defaults;
                    clicked => {
                        root.confirm-reset = true;
                    }
                }
                if root.confirm-reset: VerticalLayout {
                    spacing: Theme.spacing-s;
                    Label {
                        text: Texts.reset-question;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing-s;
                        AppButton {
                            compact: true;
                            text: Texts.back-cancel;
                            clicked => {
                                root.confirm-reset = false;
                            }
                        }
                        AppButton {
                            compact: true;
                            text: Texts.reset-confirm;
                            primary: true;
                            clicked => {
                                root.confirm-reset = false;
                                Backend.settings-reset();
                            }
                        }
                    }
                }

                AppButton {
                    text: Texts.info;
                    clicked => {
                        Backend.about-requested();
                    }
                }
            }
        }
    }
}
